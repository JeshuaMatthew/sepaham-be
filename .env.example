DB_URL=postgresql+asyncpg://sepaham:sepaham@localhost:5432/sepaham
# Wajib diganti dengan string acak yang panjang. Jangan pakai nilai contoh ini.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRY_HOURS=72
BIND_ADDR=0.0.0.0:8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
LIVEKIT_URL=ws://localhost:7880
# Wajib diisi dengan kredensial dari server LiveKit sendiri (lihat livekit.yaml).
# Jangan pakai nilai contoh ini di environment mana pun.
LIVEKIT_API_KEY=ganti-dengan-api-key-livekit
LIVEKIT_API_SECRET=ganti-dengan-api-secret-livekit
# Opsional. Wajib diisi kalau login Google via ID token dipakai; tanpa ini
# verifikasi ID token ditolak dan hanya alur access token yang jalan.
GOOGLE_CLIENT_ID=
# Opsional. Kalau diisi, analisis esai onboarding memakai model ini;
# kalau kosong, dipakai pencocokan keyword (method="keyword").
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
