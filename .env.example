# Copy to .env and adjust. Loaded by dotenvy at startup.

# Postgres connection string (matches docker-compose.yml defaults).
DATABASE_URL=postgres://sepaham:sepaham@localhost:5432/sepaham

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET=dev-secret-change-me-please-use-a-long-random-string

# How long an access token stays valid, in hours.
JWT_EXPIRY_HOURS=72

# Address the API listens on.
BIND_ADDR=0.0.0.0:8080

# Public base URL of this server, used to build absolute image URLs
# (stored WebP images are served at {PUBLIC_BASE_URL}/uploads/<file>.webp).
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated list of allowed CORS origins (the frontend dev servers).
# Vite picks the next free port when 5173 is taken, so allow a small range.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=sepaham_backend=debug,tower_http=debug,info

# LiveKit (group voice/video calls). Defaults match `livekit-server --dev`.
# LIVEKIT_URL is the ws:// address the FRONTEND connects to.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Gemini AI (Google AI Studio). Get your key at https://aistudio.google.com/app/apikey
# The key must ONLY live here — never in source code or frontend bundles.
GEMINI_API_KEY=
